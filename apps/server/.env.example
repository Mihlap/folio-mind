# API
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars-long
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (Docker Postgres on host port 5434 — see docs/DEPLOY.md)
# На Windows используйте 127.0.0.1, не localhost — иначе может попасть на другой Postgres (IPv6).
DATABASE_URL=postgresql://folio:folio@127.0.0.1:5434/folio_mind

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Observability (optional, console traces in dev)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# S3 (Timeweb Cloud). Все файлы — только под ключом folioFiles/… (см. packages/pdf-contracts/src/s3-paths.ts)
# Dev с локальным MinIO (docker compose up -d minio minio-init):
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minio
# S3_SECRET_ACCESS_KEY=miniosecret
# S3_BUCKET_NAME=folio-mind
# S3_PUBLIC_URL=http://127.0.0.1:9000/folio-mind
# S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# AI (GigaChat)
AI_PROVIDER=gigachat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT=180

# Yandex GPT (опционально)
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=
YANDEX_MODEL=yandexgpt/latest

# Превью PDF (server + worker)
PREVIEW_INITIAL_PAGES=15
PREVIEW_MAX_PAGES=200
PREVIEW_THUMB_BATCH=20
PREVIEW_JOB_TIMEOUT_MS=300000

# Worker: конвертация DOCX ↔ PDF
GOTENBERG_URL=http://127.0.0.1:3003
PDF_TO_DOCX_URL=http://127.0.0.1:8080
PREVIEW_WORKER_CONCURRENCY=2
OPTIMIZE_WORKER_CONCURRENCY=1
AI_WORKER_CONCURRENCY=1

# Очереди: /health → degraded если waiting >= порога
QUEUE_WARN_WAITING=50
AI_JOB_TIMEOUT_MS=180000

# Лимиты ИИ на tenant (запросов в сутки)
AI_TENANT_DAILY_REQUESTS=100

# Password reset (dev prints link to console)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
# SKIP_EMAIL_MX_CHECK=true

# CAPTCHA (Cloudflare Turnstile). Secret на сервере + VITE_TURNSTILE_SITE_KEY на клиенте.
# TURNSTILE_SECRET_KEY=
# Клиент: apps/client/.env → VITE_TURNSTILE_SITE_KEY=

# OAuth redirect URI в консоли провайдера:
#   http://localhost:3001/auth/oauth/google/callback
#   http://localhost:3001/auth/oauth/yandex/callback
# API_PUBLIC_URL=https://api.your-domain.com  (prod)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=

MAGIC_LINK_TOKEN_TTL_MINUTES=15

# SMTP (для реальной отправки письма восстановления пароля и уведомлений о замечаниях гостя)
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="РазУм <no-reply@example.com>"

# Webhook при новом замечании гостя (опционально, JSON POST)
# GUEST_COMMENT_WEBHOOK_URL=https://hooks.example.com/folio/guest-comment
# Telegram Bot API (опционально, параллельно с email и generic webhook):
# GUEST_COMMENT_TELEGRAM_BOT_TOKEN=123456:ABC...
# GUEST_COMMENT_TELEGRAM_CHAT_ID=-1001234567890

# Медиатека (изображения tenant, отдельно от PDF до 100 МБ)
# MEDIA_MAX_FILE_BYTES=26214400
# MEDIA_TENANT_QUOTA_BYTES=10737418240
# MEDIA_MAX_PIXEL_SIDE=6000
