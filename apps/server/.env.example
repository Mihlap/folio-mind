# API
NODE_ENV=development
PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-min-32-chars-long
CORS_ORIGIN=http://localhost:5173

# Database (Docker Postgres on host port 5434 — see docs/DEPLOY.md)
DATABASE_URL=postgresql://folio:folio@localhost:5434/folio_mind

# Redis
REDIS_URL=redis://localhost:6379

# Observability (optional, console traces in dev)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# S3 (Timeweb Cloud; объекты под префиксом folioFiles/)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# AI (GigaChat)
AI_PROVIDER=gigachat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT=180

# Yandex GPT (опционально)
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=
