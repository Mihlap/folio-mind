# На Windows — 127.0.0.1, не localhost (см. apps/server/.env.example)
REDIS_URL=redis://127.0.0.1:6379

OTEL_ENABLED=false

# Конвертация (те же URL, что в apps/server/.env — worker читает server/.env)
# GOTENBERG_URL=http://127.0.0.1:3003
# PDF_TO_DOCX_URL=http://127.0.0.1:8080
# PDF_TO_DOCX_TIMEOUT_MS=600000
# PRECONVERT_MAX_PDF_MB=45  # фоновый pre-convert при upload; 0 = без лимита. Крупные PDF — загружайте с DOCX.

# Для очереди ai — те же ключи, что в apps/server/.env (worker читает server/.env):
# DATABASE_URL=
# S3_*=
# GIGACHAT_CREDENTIALS=

# Сжатие PDF и PDF/A: пути к бинарникам, если не в PATH и не в tools/
# Windows без админ-прав: powershell -File .\tools\install-ghostscript.ps1
# QPDF_BIN=qpdf
# GHOSTSCRIPT_BIN=C:\path\to\gswin64c.exe
# PREVIEW_VIEW_WIDTH=1440  # ширина PNG для гостевого просмотра (миниатюры — 160px)
