    "@folio-mind/observability": "workspace:*",
    "@folio-mind/pdf-contracts": "workspace:*",
    "@smithy/node-http-handler": "^4.7.3",
    "@napi-rs/canvas": "^0.1.65",
    "@prisma/client": "^6.5.0",
    "bullmq": "^5.41.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.5.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
