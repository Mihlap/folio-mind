{
  "name": "folio-mind",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@folio-mind/client --filter=@folio-mind/server --filter=@folio-mind/worker",
    "dev:client": "pnpm --filter @folio-mind/client dev",
    "dev:server": "pnpm --filter @folio-mind/server dev",
    "build": "turbo run build",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "db:generate": "pnpm --filter @folio-mind/server exec prisma generate",
    "db:migrate": "pnpm --filter @folio-mind/server exec prisma migrate dev",
    "db:regen-migration": "node apps/server/scripts/regen-migration.cjs",
    "db:push": "pnpm --filter @folio-mind/server exec prisma db push",
    "smoke:phase1": "node tools/smoke-phase1.mjs",
    "smoke:phase2": "node tools/smoke-phase2.mjs",
    "smoke:phase3": "node tools/smoke-phase3.mjs",
    "smoke:phase3:docx": "node tools/smoke-phase3-docx.mjs",
    "smoke:phase3:pdf2docx": "node tools/smoke-phase3-pdf2docx.mjs",
    "smoke:rag": "node tools/smoke-rag-chat.mjs",
    "smoke:presentation": "node tools/presentation/smoke.mjs",
    "smoke:presentation:seed": "node tools/presentation/seed-demo.mjs",
    "smoke:presentation:ui": "node tools/presentation/ui-check.mjs",
    "mobile:sync": "pnpm --filter @folio-mind/mobile sync",
    "mobile:open:android": "pnpm --filter @folio-mind/mobile open:android",
    "mobile:apk:debug": "pnpm --filter @folio-mind/mobile assemble:debug"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
